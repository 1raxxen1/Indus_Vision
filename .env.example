# Copy this file to .env and fill in local-only secrets/settings.
# Never commit .env. It is ignored by git.

# Hugging Face hosted API token. Create a token at https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here

# Keep the large Llama Vision model disabled for 6 GB GPUs.
VISION_ENABLE_LOCAL_MODEL=false

# Hosted Hugging Face signals.
HF_ENABLE_IMAGE_DETECTION=true
HF_ENABLE_IMAGE_TEXT=true

# Local BLIP captioning for RTX 3050/3060 6 GB. Enable only after CUDA PyTorch works.
HF_ENABLE_LOCAL_IMAGE_TEXT=false
HF_IMAGE_TEXT_PREFER_LOCAL=false
HF_IMAGE_TEXT_DEVICE=cuda
HF_IMAGE_TEXT_MODEL=Salesforce/blip-image-captioning-base

# PaddleOCR. Start on CPU to save VRAM.
PADDLE_OCR_ENABLED=true
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_LANG=en
PADDLE_OCR_MAX_SIDE_LEN=1280
PADDLE_OCR_DET_LIMIT_SIDE_LEN=960

# Disable Selenium/Chrome pricing while testing AI locally to reduce RAM use.
SELENIUM_PRICING_ENABLED=false
